 else{cat="Obese"}
 el.bmiVal.textContent=bmi.toFixed(1);
 el.bmiNote.textContent=cat+" — BMI reflects overall size relative to height, not shape or frame.";

 if(wr>0){
  var wrCm=unit==="cm"?wr:wr*2.54;
  var ratio=hCm/wrCm;
  var frame,note;
  if(sex==="male"){
   if(ratio>10.4){frame="Small Frame";note="Height-to-wrist ratio of "+ratio.toFixed(1)+" — above 10.4 for men. Classic ideal-weight charts are often adjusted about 10% lower for a small frame."}
   else if(ratio>=9.6){frame="Medium Frame";note="Height-to-wrist ratio of "+ratio.toFixed(1)+" — the average range for men (9.6\u201310.4). Standard weight charts apply without adjustment."}
   else{frame="Large Frame";note="Height-to-wrist ratio of "+ratio.toFixed(1)+" — below 9.6 for men. Classic ideal-weight charts are often adjusted about 10% higher for a large frame."}
  }else{
   if(ratio>11.0){frame="Small Frame";note="Height-to-wrist ratio of "+ratio.toFixed(1)+" — above 11.0 for women. Classic ideal-weight charts are often adjusted about 10% lower for a small frame."}
   else if(ratio>=10.1){frame="Medium Frame";note="Height-to-wrist ratio of "+ratio.toFixed(1)+" — the average range for women (10.1\u201311.0). Standard weight charts apply without adjustment."}
   else{frame="Large Frame";note="Height-to-wrist ratio of "+ratio.toFixed(1)+" — below 10.1 for women. Classic ideal-weight charts are often adjusted about 10% higher for a large frame."}
  }
  el.frameVal.textContent=frame;
  el.frameNote.textContent=note;
  el.frameCard.hidden=false;
  el.noFrameNote.hidden=true;
 }else{
  el.frameCard.hidden=true;
  el.noFrameNote.hidden=false;
 }

 el.res.classList.add("bfs-show");
 requestAnimationFrame(function(){el.res.scrollIntoView({behavior:"smooth",block:"nearest"})});
}

function reset(){
 el.res.classList.remove("bfs-show");
 el.err.classList.remove("bfs-show");
 el.height.value=el.weight.value=el.wrist.value="";
 el.height.focus();
}

root.addEventListener("click",function(e){
 var b=e.target.closest("[data-act]");
 if(!b)return;
 var a=b.dataset.act;
 if(a==="calc")calculate();
 else if(a==="reset")reset();
 else if(a==="sex")setToggle(b.dataset.v,sBtns,function(v){sex=v});
 else if(a==="unit")changeUnit(b.dataset.v);
});
root.addEventListener("keydown",function(e){
 if(e.key==="Enter"&&e.target.tagName==="INPUT"){e.preventDefault();calculate()}
});
})();
</script>

