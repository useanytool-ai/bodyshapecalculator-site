var root=document.getElementById("whtr-app");
if(!root||root.dataset.whtrInit)return;root.dataset.whtrInit="1";
var $=function(i){return document.getElementById(i)};
var el={
 waist:$("whtr-waist"),height:$("whtr-height"),err:$("whtr-error"),res:$("whtr-results"),
 val:$("whtr-val"),risk:$("whtr-risk"),dot:$("whtr-dot"),note:$("whtr-note"),
 milDod:$("whtr-mil-dod"),milNavy:$("whtr-mil-navy"),milAf:$("whtr-mil-af"),milUsmc:$("whtr-mil-usmc")
};
var units=root.querySelectorAll(".whtr-u");
var uBtns=root.querySelectorAll('[data-act="unit"]');
var unit="cm";

function setUnit(v,btns,cb){
 for(var i=0;i<btns.length;i++){
  var on=btns[i].dataset.v===v;
  btns[i].classList.toggle("whtr-active",on);
  btns[i].setAttribute("aria-pressed",on?"true":"false");
 }
 cb(v);
}
function changeUnit(v){
 if(v===unit)return;
 var factor=v==="in"?(1/2.54):2.54;
 var inputs=[el.waist,el.height];
 for(var i=0;i<inputs.length;i++){
  var val=parseFloat(inputs[i].value);
  if(val>0)inputs[i].value=Math.round(val*factor*100)/100;
 }
 unit=v;
 setUnit(v,uBtns,function(vv){for(var j=0;j<units.length;j++)units[j].textContent=vv});
}

function calculate(){
 var w=parseFloat(el.waist.value),h=parseFloat(el.height.value);
 if(!(w>0)||!(h>0)){
  el.err.classList.add("whtr-show");
  (w>0?el.height:el.waist).focus();
  return;
 }
 el.err.classList.remove("whtr-show");
 var whtr=w/h;
 el.val.textContent=whtr.toFixed(2);

 var riskLabel,riskClass,note;
 if(whtr<0.40){
  riskLabel="Below Typical Range";riskClass="whtr-risk-low";
  note="Your ratio sits below the usual healthy band. This isn't a risk category in the same sense as the higher bands \u2014 if it's unexpected or unintentional, it's worth mentioning to a doctor.";
 }else if(whtr<0.50){
  riskLabel="Healthy Range";riskClass="whtr-risk-healthy";
  note="Your waist measures less than half your height, which is the benchmark most public-health guidance on WHtR is built around.";
 }else if(whtr<0.60){
  riskLabel="Increased Risk";riskClass="whtr-risk-mod";
  note="Your waist is more than half your height. This band is generally associated with increased cardiometabolic risk \u2014 worth pairing with a waist-to-hip ratio check and a conversation with a doctor if you have other risk factors.";
 }else{
  riskLabel="High Risk";riskClass="whtr-risk-high";
  note="Your ratio is in the range generally associated with the highest abdominal-fat-related risk on this measure. A doctor can help interpret this alongside your full health picture rather than this number alone.";
 }
 el.risk.textContent=riskLabel;
 el.risk.className="whtr-result-risk "+riskClass;
 el.note.textContent=note;

 var dodPass=whtr<0.55,usmcPass=whtr<=0.52,whr3=whtr.toFixed(3);
 el.milDod.textContent=whr3+" \u2014 "+(dodPass?"Meets standard (< 0.55)":"Above standard (\u2265 0.55)");
 el.milDod.style.color=dodPass?"#6fcf97":"#eb5757";
 el.milNavy.textContent=whr3+" \u2014 "+(dodPass?"Meets standard (< 0.55)":"Above standard (\u2265 0.55)");
 el.milNavy.style.color=dodPass?"#6fcf97":"#eb5757";
 el.milUsmc.textContent=whr3+" \u2014 "+(usmcPass?"Meets standard (\u2264 0.52)":"Above standard (> 0.52)");
 el.milUsmc.style.color=usmcPass?"#6fcf97":"#eb5757";
 var afPoints=whtr<=0.50?20:whtr>=0.60?0:Math.round(20-(whtr-0.50)*200);
 el.milAf.textContent="~"+afPoints+"/20 points (est.)"+(afPoints===0?" \u2014 component failure":"");
 el.milAf.style.color=afPoints>=15?"#6fcf97":afPoints>0?"#f2c94c":"#eb5757";

 var pos=Math.min(Math.max((whtr-0.3)/(0.7-0.3),0),1)*100;
 el.dot.style.left=pos+"%";

 el.res.classList.add("whtr-show");
 requestAnimationFrame(function(){el.res.scrollIntoView({behavior:"smooth",block:"nearest"})});
}

function reset(){
 el.res.classList.remove("whtr-show");
 el.err.classList.remove("whtr-show");
 el.waist.value=el.height.value="";
 el.waist.focus();
}

root.addEventListener("click",function(e){
 var b=e.target.closest("[data-act]");
 if(!b)return;
 var a=b.dataset.act;
 if(a==="calc")calculate();
 else if(a==="reset")reset();
 else if(a==="unit")changeUnit(b.dataset.v);
});
root.addEventListener("keydown",function(e){
 if(e.key==="Enter"&&e.target.tagName==="INPUT"){e.preventDefault();calculate()}
});
})();
</script>

