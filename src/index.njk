root.addEventListener("click",function(e){
 var b=e.target.closest("[data-act]");
 if(!b)return;
 var a=b.dataset.act;
 if(a==="calc")calculate();
 else if(a==="reset")reset();
 else if(a==="share")shareLink();
 else if(a==="download")downloadImage();
 else if(a==="download-story")downloadImageStory();
 else if(a==="unit")changeUnit(b.dataset.v);
 else if(a==="wunit")changeWUnit(b.dataset.v);
});
var requiredOrder=[el.bust,el.waist,el.hh,el.hips];
root.addEventListener("keydown",function(e){
 if(e.key==="Enter"&&e.target.tagName==="INPUT"){
  e.preventDefault();
  var idx=requiredOrder.indexOf(e.target);
  if(idx>-1){
   var next=null;
   for(var i=idx+1;i<requiredOrder.length;i++){if(!requiredOrder[i].value){next=requiredOrder[i];break}}
   if(next){next.focus();return}
  }
  calculate();
 }
});
var progressDots=root.querySelectorAll(".btc-progress-dot");
function updateProgress(){
 for(var i=0;i<requiredOrder.length;i++){
  progressDots[i].classList.toggle("btc-filled",!!requiredOrder[i].value);
 }
}
requiredOrder.forEach(function(inp){inp.addEventListener("input",updateProgress)});

(function prefillFromUrl(){
 try{
  var qs=new URLSearchParams(location.search);
  if(!qs.has("bust"))return;
