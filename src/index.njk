 return bvPromise;
}
function render3d(o){
 var fig=$("btc-3d"),cv=$("btc-3d-canvas");if(!fig||!cv)return;
 loadEngine().then(function(C){
  var H=o.htCm>=120&&o.htCm<=230?o.htCm:165;
  var W=o.wtKg>0?o.wtKg:22*Math.pow(o.hips/(96*Math.pow(H/165,0.6)),2.5)*Math.pow(H/100,2);
  var r=C.rangeFor("weight",{height:H});W=Math.min(r[1],Math.max(r[0],W));
  var b=C.makeBody("f",H,W);
  b.bust=o.bust;b.waist=o.waist;b.hips=o.hips;C.sanitize(b);
  if(o.hh>0)b.highhip=o.hh;
  var m=C.buildModel(b),L=m.levels;
  var cw=cv.width,ch=cv.height,y0=Math.max(0,m.yCrotch*0.52),y1=H+3,sc=(ch-36)/(y1-y0),gy=26+y1*sc;
  var off=document.createElement("canvas");off.width=cw;off.height=ch;
  var ox=off.getContext("2d"),img=ox.createImageData(cw,ch);
  var narrow=(cv.getBoundingClientRect().width||fig.parentNode.clientWidth||600)<520;
  var xF=narrow?cw*0.62:cw*0.40,x3=cw*0.80,col=[221,199,158];
  if(!narrow)C.rasterize(img.data,cw,ch,m,{scale:sc,cxPx:x3,groundPx:gy,theta:0.62,color:col,alpha:0.62});
  C.rasterize(img.data,cw,ch,m,{scale:sc,cxPx:xF,groundPx:gy,theta:0,color:col});
  ox.putImageData(img,0,0);
  var ctx=cv.getContext("2d");ctx.clearRect(0,0,cw,ch);ctx.drawImage(off,0,0);
  var f=unit==="cm"?1:1/2.54,u=unit;
  var lines=[["Bust",L.bust,o.bust,"#f0d48a"],["Waist",L.waist,o.waist,"#f0d48a"]];
  if(o.hh>0)lines.push(["High hip",L.highhip,o.hh,"#7fd6c8"]);
  lines.push(["Hips",L.hips,o.hips,"#f0d48a"]);
  ctx.font="bold "+(narrow?44:26)+"px -apple-system,Segoe UI,Roboto,Arial,sans-serif";ctx.textBaseline="middle";
  for(var i=0;i<lines.length;i++){
   var ln=lines[i],yy=gy-ln[1]*sc,e=C.extentsAt(m,ln[1],0);if(!e)continue;
   var xa=xF+e[0]*sc-10,xb=xF+e[1]*sc+10;
   ctx.strokeStyle=ln[3];ctx.lineWidth=narrow?3.4:2.4;ctx.setLineDash([9,7]);ctx.beginPath();ctx.moveTo(xa,yy);ctx.lineTo(xb,yy);ctx.stroke();ctx.setLineDash([]);
   ctx.beginPath();ctx.moveTo(xa,yy-8);ctx.lineTo(xa,yy+8);ctx.moveTo(xb,yy-8);ctx.lineTo(xb,yy+8);ctx.stroke();
   ctx.fillStyle=ln[3];ctx.textAlign="right";ctx.fillText(ln[0]+" "+fmt(ln[2]*f)+" "+u,xa-12,yy);
  }
  var a=[H,W,o.bust,o.waist,o.hips,"","","","",""].map(function(v){return v===""?"":Math.round(v*10)/10});
  $("btc-3d-link").href="/body-visualizer/#v=1&sx=f&u="+(unit==="cm"?"m":"i")+"&a="+a.join(",");
  fig.hidden=false;last3d=cv;
 }).catch(function(){fig.hidden=true;last3d=null});
}

function reset(){
var f3=$("btc-3d");if(f3)f3.hidden=true;last3d=null;
 el.res.classList.remove("btc-show");
 el.insight.classList.remove("btc-show");
 el.err.classList.remove("btc-show");
 if(activeSil){activeSil.classList.remove("btc-active");activeSil=null}
 el.bust.value=el.waist.value=el.hh.value=el.hips.value=el.age.value=el.ht.value=el.wt.value="";
 for(var i=0;i<4;i++)bars[i].style.width="0%";
 if(typeof updateProgress==="function")updateProgress();
 el.bust.focus();
}

function setUnit(v,btns,cb){
 for(var i=0;i<btns.length;i++){
  var on=btns[i].dataset.v===v;
  btns[i].classList.toggle("btc-active",on);
  btns[i].setAttribute("aria-pressed",on?"true":"false");
 }
 cb(v);
}
var uBtns=root.querySelectorAll('[data-act="unit"]'),wBtns=root.querySelectorAll('[data-act="wunit"]');

function changeUnit(v){
 if(v===unit)return;
 var factor=v==="in"?(1/2.54):2.54;
 var inputs=[el.bust,el.waist,el.hh,el.hips,el.ht];
 for(var i=0;i<inputs.length;i++){
  var val=parseFloat(inputs[i].value);
  if(val>0)inputs[i].value=Math.round(val*factor*100)/100;
 }
 unit=v;
 setUnit(v,uBtns,function(vv){for(var j=0;j<units.length;j++)units[j].textContent=vv});
}
function changeWUnit(v){
 if(v===wUnit)return;
 var factor=v==="lb"?2.20462:(1/2.20462);
 var val=parseFloat(el.wt.value);
 if(val>0)el.wt.value=Math.round(val*factor*100)/100;
 wUnit=v;
 setUnit(v,wBtns,function(vv){el.wu.textContent=vv});
}

function flashCopyBtn(ok){
 var b=$("btc-copy-btn"); if(!b)return;
 var orig="Copy result link";
 b.textContent=ok?"Copied!":"Couldn't copy \u2014 try again";
 setTimeout(function(){b.textContent=orig;},1800);
}
function shareLink(){
 var p=new URLSearchParams();
 p.set("bust",el.bust.value);p.set("waist",el.waist.value);p.set("hh",el.hh.value);p.set("hips",el.hips.value);
 p.set("unit",unit);
 if(el.age.value)p.set("age",el.age.value);
 if(el.ht.value)p.set("ht",el.ht.value);
 if(el.wt.value){p.set("wt",el.wt.value);p.set("wunit",wUnit);}
 var url=location.origin+location.pathname+"?"+p.toString()+"#btc-app";
 if(navigator.clipboard&&navigator.clipboard.writeText){
  navigator.clipboard.writeText(url).then(function(){flashCopyBtn(true)},function(){flashCopyBtn(false)});
 }else{
  try{
   var ta=document.createElement("textarea");ta.value=url;ta.style.position="fixed";ta.style.opacity="0";
   document.body.appendChild(ta);ta.select();document.execCommand("copy");document.body.removeChild(ta);
   flashCopyBtn(true);
  }catch(e){flashCopyBtn(false)}
 }
}

function wrapText(ctx,text,x,y,maxW,lh){
 var words=text.split(" "),line="",yy=y;
 for(var i=0;i<words.length;i++){
  var test=line+words[i]+" ";
  if(ctx.measureText(test).width>maxW&&line){ctx.fillText(line,x,yy);line=words[i]+" ";yy+=lh;}
  else line=test;
 }
 ctx.fillText(line,x,yy);
 return yy+lh;
}
