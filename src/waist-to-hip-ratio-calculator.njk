    <ul class="whrc-sources">
      <li>World Health Organization. <em>Waist Circumference and Waist-Hip Ratio: Report of a WHO Expert Consultation</em>, 2008 — WHO abdominal obesity thresholds and measurement protocol.</li>
      <li>World Health Organization. <em>WHO STEPS Surveillance Manual</em> — waist and hip measurement procedure.</li>
      <li>Yusuf S, Hawken S, Ôunpuu S, et al. "Effect of potentially modifiable risk factors associated with myocardial infarction in 52 countries (the INTERHEART study): case-control study." <em>The Lancet</em>, 2004;364(9438):937–952.</li>
    </ul>

    <p class="whrc-disc">This calculator is for educational purposes only. It does not diagnose any medical condition and isn't a substitute for advice from a qualified healthcare professional.</p>

  </div>
</div>

<script id="whrc-js">
(function(){
"use strict";
var root=document.getElementById("whrc-app");
if(!root||root.dataset.whrcInit)return;root.dataset.whrcInit="1";
var $=function(i){return document.getElementById(i)};
var el={
 waist:$("whrc-waist"),hip:$("whrc-hip"),err:$("whrc-error"),res:$("whrc-results"),
 val:$("whrc-val"),risk:$("whrc-risk"),dot:$("whrc-dot"),note:$("whrc-note"),
 gaugeMid:$("whrc-gauge-mid")
};
var units=root.querySelectorAll(".whrc-u");
var gender="female",unit="cm";
var gBtns=root.querySelectorAll('[data-act="gender"]'),uBtns=root.querySelectorAll('[data-act="unit"]');

function setToggle(v,btns,cb){
 for(var i=0;i<btns.length;i++){
  var on=btns[i].dataset.v===v;
  btns[i].classList.toggle("whrc-active",on);
  btns[i].setAttribute("aria-pressed",on?"true":"false");
 }
 cb(v);
}
function changeUnit(v){
 if(v===unit)return;
 var factor=v==="in"?(1/2.54):2.54;
 var inputs=[el.waist,el.hip];
 for(var i=0;i<inputs.length;i++){
  var val=parseFloat(inputs[i].value);
  if(val>0)inputs[i].value=Math.round(val*factor*10000)/10000;
 }
 unit=v;
 setToggle(v,uBtns,function(vv){for(var j=0;j<units.length;j++)units[j].textContent=vv});
}

function calculate(){
 var w=parseFloat(el.waist.value),h=parseFloat(el.hip.value);
 if(!(w>0)||!(h>0)){el.err.classList.add("whrc-show");return}
 el.err.classList.remove("whrc-show");
 var whr=w/h;
 el.val.textContent=whr.toFixed(2);

 var threshold=gender==="male"?0.90:0.85;
 var riskLabel,riskClass,note;
 if(whr<threshold){
  riskLabel="Below WHO Threshold";riskClass="whrc-risk-low";
  note="Your ratio is below the WHO's "+threshold.toFixed(2)+" threshold for abdominal obesity in "+(gender==="male"?"men":"women")+". This reflects fat distribution only \u2014 it isn't a full health assessment on its own.";
 }else{
  riskLabel="Above WHO Threshold";riskClass="whrc-risk-high";
  note="Your ratio is at or above the WHO's "+threshold.toFixed(2)+" threshold for abdominal obesity in "+(gender==="male"?"men":"women")+". If you have a naturally narrow hip frame, this can run high without the same fat-distribution pattern \u2014 waist-to-height ratio is a useful second check. Either way, a doctor is the right person to interpret this for your specific situation.";
 }
 el.risk.textContent=riskLabel;
 el.risk.className="whrc-result-risk "+riskClass;
 el.note.textContent=note;
 el.gaugeMid.textContent=threshold.toFixed(2);

 var pos=Math.min(Math.max((whr-0.6)/(1.1-0.6),0),1)*100;
 el.dot.style.left=pos+"%";

 el.res.classList.add("whrc-show");
 requestAnimationFrame(function(){el.res.scrollIntoView({behavior:"smooth",block:"nearest"})});
}

function reset(){
 el.res.classList.remove("whrc-show");
 el.err.classList.remove("whrc-show");
 el.waist.value=el.hip.value="";
 el.waist.focus();
}

root.addEventListener("click",function(e){
 var b=e.target.closest("[data-act]");
 if(!b)return;
 var a=b.dataset.act;
 if(a==="calc")calculate();
 else if(a==="reset")reset();
 else if(a==="gender"){setToggle(b.dataset.v,gBtns,function(v){gender=v});if(el.res.classList.contains("whrc-show"))calculate();}
 else if(a==="unit"){changeUnit(b.dataset.v);if(el.res.classList.contains("whrc-show"))calculate();}
});
root.addEventListener("keydown",function(e){
 if(e.key==="Enter"&&e.target.tagName==="INPUT"){e.preventDefault();calculate()}
});
})();
</script>
