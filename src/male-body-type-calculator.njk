var bars=[$("mbc-bar-cw"),$("mbc-bar-ch"),$("mbc-bar-wh")];
var vals=[$("mbc-val-cw"),$("mbc-val-ch"),$("mbc-val-wh")];
var caps=[1.5,1.4,1.3];
var unit="cm",wUnit="kg",activeSil=null,lastKey=null;

var T={
trapezoid:{n:"Trapezoid",d:"Your chest is clearly wider than your hips, with a waist that tapers in noticeably between them \u2014 the classic athletic V-shape.",t:[["Defining Feature","Chest at least 3 inches wider than hips; waist at least 7 inches smaller than the chest."],["Style Tips","Fitted shirts and tailored blazers that follow your natural taper work best."],["What Suits You","Flat-front trousers, structured jackets, and anything that shows rather than hides the V-shape."],["Formula Note","Chest\u2212hips \u2265 3 in AND chest\u2212waist \u2265 7 in."]]},
inverted_triangle:{n:"Inverted Triangle",d:"Your chest is wider than your hips, but without the same waist taper \u2014 a broad, boxier build through the torso.",t:[["Defining Feature","Chest at least 3 inches wider than hips; waist less than 7 inches smaller than the chest."],["Style Tips","Single-breasted jackets with minimal shoulder padding avoid adding extra width up top."],["What Suits You","Straight or relaxed-fit trousers balance a broad torso better than slim cuts."],["Formula Note","Chest\u2212hips \u2265 3 in AND chest\u2212waist < 7 in."]]},
triangle:{n:"Triangle",d:"Your hips are wider than your chest, giving a narrower-shouldered silhouette with fullness sitting lower.",t:[["Defining Feature","Hips at least 3 inches wider than the chest."],["Style Tips","Structured shoulders and patterned or textured tops add visual width up top."],["What Suits You","Slim, tapered trousers in darker tones keep the lower half from adding further width."],["Formula Note","Hips\u2212chest \u2265 3 in."]]},
oval:{n:"Oval",d:"Your chest and hips are close in size, but your waist doesn't taper between them \u2014 fullness sits through the midsection.",t:[["Defining Feature","Chest and hips within 3 inches of each other; waist within 2 inches of \u2014 or larger than \u2014 both."],["Style Tips","Vertical lines and open layering elongate the torso without clinging at the middle."],["What Suits You","Flat-front trousers and a slightly longer, straighter shirt cut that skims rather than tucks tight."],["Formula Note","Chest\u2212hips < 3 in AND waist \u2265 (chest\u22122 in) AND waist \u2265 (hips\u22122 in)."]]},
rectangle:{n:"Rectangle",d:"Your chest, waist and hips are all fairly similar \u2014 a lean, straight silhouette without pronounced taper.",t:[["Defining Feature","Chest and hips within 3 inches of each other; waist moderately smaller than both, but not dramatically."],["Style Tips","Layering and structured shoulders add the visual dimension a straight frame doesn't naturally have."],["What Suits You","Double-breasted jackets and textured fabrics create shape where the proportions don't."],["Formula Note","Catch-all: applied when none of the other conditions are met."]]}
};

function detect(c,w,h){
 var f=unit==="cm"?0.393701:1,C=c*f,W=w*f,H=h*f;
 var ch=C-H,hc=H-C,cw=C-W;
 if(ch>=3&&cw>=7)return "trapezoid";
 if(ch>=3)return "inverted_triangle";
 if(hc>=3)return "triangle";
 if(Math.abs(ch)<3&&W>=C-2&&W>=H-2)return "oval";
 return "rectangle";
}

function insight(a,name){
 if(!a||a<10||a>100)return null;
 if(a<20)return["Teen \u00b7 Under 20","Still Developing","At <strong>"+a+"</strong>, your frame is still filling out \u2014 shoulder and chest development in particular continues well into the early twenties. Your <strong>"+name+"</strong> shape may still change. Movement and balanced nutrition tend to matter more at this stage than any particular build goal."];
 if(a<30)return["Twenties \u00b7 20\u201329","Peak Building Years","In your <strong>20s</strong>, testosterone and recovery capacity are typically at their highest, which is why muscle tends to respond quickly to training at this age \u2014 often why a <strong>"+name+"</strong> frame shifts most noticeably during this decade."];
 if(a<40)return["Thirties \u00b7 30\u201339","Metabolism Starts to Shift","Through your <strong>30s</strong>, testosterone begins a gradual decline and metabolism slows subtly. A <strong>"+name+"</strong> shape stays fairly stable for most men, though waist measurements often start to shift first. Strength training is often highlighted as particularly useful for maintaining muscle through this stage."];
 if(a<50)return["Forties \u00b7 40\u201349","Midsection Changes Become Visible","Your <strong>40s</strong> often bring a more noticeable shift in fat storage toward the abdomen as testosterone continues to decline, which can soften a <strong>"+name+"</strong> silhouette toward oval. Core strength, protein intake and sleep are commonly emphasised during this stage."];
 if(a<60)return["Fifties \u00b7 50\u201359","Muscle Maintenance Takes More Effort","In your <strong>50s</strong>, muscle mass naturally declines faster without deliberate effort to maintain it, and a <strong>"+name+"</strong> classification may shift as a result. Resistance training and adequate protein are often considered the two most relevant levers at this stage."];
 return ["Sixty+ \u00b7 60 & over","Functional Strength Focus","At <strong>"+a+"</strong>, body composition shifts naturally \u2014 but not inevitably. Your <strong>"+name+"</strong> classification is a snapshot of today. Functional strength and cardiovascular health are generally considered far more relevant than any silhouette category."];
}

var fmt=function(n){return String(Math.round(n*10)/10)};
function cmToFeetIn(cm){
 var totalIn=Math.round(cm/2.54),ft=Math.floor(totalIn/12),inch=totalIn%12;
 return ft+"'"+inch+'"';
}

function calculate(){
 var c=parseFloat(el.chest.value),w=parseFloat(el.waist.value),h=parseFloat(el.hips.value),
     age=parseInt(el.age.value,10),ht=parseFloat(el.ht.value),wt=parseFloat(el.wt.value);

 if(!(c>0)||!(w>0)||!(h>0)){
  el.err.classList.add("mbc-show");
  (c>0?(w>0?el.hips:el.waist):el.chest).focus();
  return;
 }
 el.err.classList.remove("mbc-show");

 var key=detect(c,w,h),t=T[key];
 lastKey=key;
 el.type.textContent=t.n;
 el.desc.textContent=t.d;
 el.rch.textContent=fmt(c)+" "+unit;
 el.rwa.textContent=fmt(w)+" "+unit;
 el.rhi.textContent=fmt(h)+" "+unit;

 if(activeSil)activeSil.classList.remove("mbc-active");
 for(var i=0;i<sils.length;i++){if(sils[i].dataset.k===key){activeSil=sils[i];sils[i].classList.add("mbc-active");break}}

 var r=[c/w,c/h,w/h];
 for(var j=0;j<3;j++)vals[j].textContent=r[j].toFixed(2);

 var whr=r[2],whrRisk=whr>0.90?"Above WHO threshold":"Below WHO threshold";
 el.vWhr.textContent=whr.toFixed(2);
 el.vWhr.style.color=whr>0.90?"#eb5757":"#6fcf97";
 el.sWhr.textContent=whrRisk;

 var hasHt=ht>0,hasWt=wt>0,htCm=0,wtKg=0;
 if(hasHt){
  htCm=unit==="cm"?ht:ht*2.54;
  el.vHt.textContent=fmt(ht)+" "+unit;
  el.sHt.textContent=unit==="cm"?cmToFeetIn(htCm):Math.round(htCm)+" cm";
 }
 el.siHt.hidden=!hasHt;
 if(hasWt){
  wtKg=wUnit==="kg"?wt:wt*0.453592;
  el.vWt.textContent=fmt(wt)+" "+wUnit;
  el.sWt.textContent=wUnit==="kg"?(wt*2.20462).toFixed(1)+" lb":wtKg.toFixed(1)+" kg";
 }
 el.siWt.hidden=!hasWt;
 if(hasHt&&hasWt){
  var m=htCm/100,bmi=wtKg/(m*m),cls,cat;
  var ageKnown=age>0&&age<=100;
  if(ageKnown&&age<20){cls="";cat="Adult BMI ranges don't apply under 20"}
  else if(bmi<18.5){cls="mbc-bmi-under";cat="Underweight"}
  else if(bmi<25){cls="mbc-bmi-normal";cat="Normal"}
  else if(bmi<30){cls="mbc-bmi-over";cat="Overweight"}
  else{cls="mbc-bmi-obese";cat="Obese"}
  el.vBmi.textContent=bmi.toFixed(1);
  el.vBmi.className="mbc-stat-val "+cls;
  el.sBmi.textContent=cat;
  el.siBmi.hidden=false;
 }else el.siBmi.hidden=true;

 for(var k=0;k<4;k++){
  traits[k].firstElementChild.textContent=t.t[k][0];
  traits[k].lastElementChild.textContent=t.t[k][1];
 }

 var ins=insight(age,t.n.toLowerCase());
 if(ins){el.badge.textContent=ins[0];el.insT.textContent=ins[1];el.insB.innerHTML=ins[2];el.insight.classList.add("mbc-show")}
 else el.insight.classList.remove("mbc-show");

 el.res.classList.add("mbc-show");
 requestAnimationFrame(function(){
  for(var i=0;i<3;i++)bars[i].style.width=Math.min(r[i]/caps[i]*100,100)+"%";
  el.res.scrollIntoView({behavior:"smooth",block:"nearest"});
 });
}

function reset(){
 el.res.classList.remove("mbc-show");
 el.insight.classList.remove("mbc-show");
 el.err.classList.remove("mbc-show");
 if(activeSil){activeSil.classList.remove("mbc-active");activeSil=null}
 el.chest.value=el.waist.value=el.hips.value=el.age.value=el.ht.value=el.wt.value="";
 for(var i=0;i<3;i++)bars[i].style.width="0%";
 if(typeof updateProgress==="function")updateProgress();
 el.chest.focus();
}

function setUnit(v,btns,cb){
 for(var i=0;i<btns.length;i++){
  var on=btns[i].dataset.v===v;
  btns[i].classList.toggle("mbc-active",on);
  btns[i].setAttribute("aria-pressed",on?"true":"false");
 }
 cb(v);
}
var uBtns=root.querySelectorAll('[data-act="unit"]'),wBtns=root.querySelectorAll('[data-act="wunit"]');

function changeUnit(v){
 if(v===unit)return;
 var factor=v==="in"?(1/2.54):2.54;
 var inputs=[el.chest,el.waist,el.hips,el.ht];
 for(var i=0;i<inputs.length;i++){
  var val=parseFloat(inputs[i].value);
  if(val>0)inputs[i].value=Math.round(val*factor*100)/100;
 }
 unit=v;
 setUnit(v,uBtns,function(vv){for(var j=0;j<units.length;j++)units[j].textContent=vv});
}
function changeWUnit(v){
 if(v===wUnit)return;
 var factor=v==="lb"?2.20462:(1/2.20462);
 var val=parseFloat(el.wt.value);
 if(val>0)el.wt.value=Math.round(val*factor*100)/100;
 wUnit=v;
 setUnit(v,wBtns,function(vv){el.wu.textContent=vv});
}

function flashCopyBtn(ok){
 var b=$("mbc-copy-btn"); if(!b)return;
 var orig="Copy result link";
 b.textContent=ok?"Copied!":"Couldn't copy \u2014 try again";
 setTimeout(function(){b.textContent=orig;},1800);
}
function shareLink(){
 var p=new URLSearchParams();
 p.set("chest",el.chest.value);p.set("waist",el.waist.value);p.set("hips",el.hips.value);
 p.set("unit",unit);
 if(el.age.value)p.set("age",el.age.value);
 if(el.ht.value)p.set("ht",el.ht.value);
 if(el.wt.value){p.set("wt",el.wt.value);p.set("wunit",wUnit);}
 var url=location.origin+location.pathname+"?"+p.toString()+"#mbc-app";
 if(navigator.clipboard&&navigator.clipboard.writeText){
  navigator.clipboard.writeText(url).then(function(){flashCopyBtn(true)},function(){flashCopyBtn(false)});
 }else{
  try{
   var ta=document.createElement("textarea");ta.value=url;ta.style.position="fixed";ta.style.opacity="0";
   document.body.appendChild(ta);ta.select();document.execCommand("copy");document.body.removeChild(ta);
   flashCopyBtn(true);
  }catch(e){flashCopyBtn(false)}
 }
}

function wrapText(ctx,text,x,y,maxW,lh){
 var words=text.split(" "),line="",yy=y;
 for(var i=0;i<words.length;i++){
  var test=line+words[i]+" ";
  if(ctx.measureText(test).width>maxW&&line){ctx.fillText(line,x,yy);line=words[i]+" ";yy+=lh;}
  else line=test;
 }
 ctx.fillText(line,x,yy);
 return yy+lh;
}
function downloadImage(){
 var t=T[lastKey]; if(!t)return;
 var c=document.createElement("canvas"); c.width=800;c.height=900;
 var ctx=c.getContext("2d");
 var grad=ctx.createLinearGradient(0,0,0,900);
 grad.addColorStop(0,"#0d0d0d");grad.addColorStop(1,"#161616");
 ctx.fillStyle=grad;ctx.fillRect(0,0,800,900);
 ctx.strokeStyle="#c9a84c";ctx.lineWidth=2;ctx.strokeRect(20,20,760,860);
 ctx.textAlign="center";
 ctx.fillStyle="#8a8a8a";ctx.font="14px Georgia, serif";
 ctx.fillText("YOUR BODY TYPE RESULT",400,110);
 ctx.fillStyle="#c9a84c";ctx.font="bold 56px Georgia, serif";
 ctx.fillText(t.n,400,185);
 ctx.fillStyle="#bdb6a8";ctx.font="16px Georgia, sans-serif";
 var afterDesc=wrapText(ctx,t.d,400,235,640,24);

 var mY=Math.max(afterDesc+30,330);
 ctx.strokeStyle="#2a2a2a";ctx.beginPath();ctx.moveTo(60,mY);ctx.lineTo(740,mY);ctx.stroke();
 var mLabels=["Chest","Waist","Hips"];
 var mValues=[el.rch.textContent,el.rwa.textContent,el.rhi.textContent];
 for(var i=0;i<3;i++){
  var x=180+i*220;
  ctx.fillStyle="#f0e8d8";ctx.font="bold 22px Georgia, serif";ctx.fillText(mValues[i],x,mY+50);
  ctx.fillStyle="#8a8a8a";ctx.font="11px sans-serif";ctx.fillText(mLabels[i].toUpperCase(),x,mY+72);
 }

 var ry=mY+120;
 ctx.textAlign="left";
 ctx.fillStyle="#c9a84c";ctx.font="bold 13px sans-serif";
 ctx.fillText("PROPORTIONAL RATIOS",60,ry);
 var rLabels=["Chest\u2013Waist","Chest\u2013Hip","Waist\u2013Hip (WHR)"];
 var rValues=[vals[0].textContent,vals[1].textContent,el.vWhr.textContent];
 for(var j=0;j<rValues.length;j++){
  var yy=ry+34+j*30;
  ctx.textAlign="left";ctx.fillStyle="#8a8a8a";ctx.font="14px sans-serif";ctx.fillText(rLabels[j],60,yy);
  ctx.textAlign="right";ctx.fillStyle="#f0e8d8";ctx.font="bold 14px Georgia, serif";ctx.fillText(rValues[j],740,yy);
 }

 ctx.textAlign="center";ctx.fillStyle="#555";ctx.font="12px sans-serif";
 ctx.fillText(location.hostname||"Body Type Calculator for Men",400,860);

 var url=c.toDataURL("image/png");
 var a=document.createElement("a");a.href=url;a.download="male-body-type-result.png";
 document.body.appendChild(a);a.click();document.body.removeChild(a);
}

root.addEventListener("click",function(e){
 var b=e.target.closest("[data-act]");
 if(!b)return;
 var a=b.dataset.act;
 if(a==="calc")calculate();
 else if(a==="reset")reset();
 else if(a==="share")shareLink();
 else if(a==="download")downloadImage();
 else if(a==="unit")changeUnit(b.dataset.v);
 else if(a==="wunit")changeWUnit(b.dataset.v);
});
var requiredOrder=[el.chest,el.waist,el.hips];
root.addEventListener("keydown",function(e){
 if(e.key==="Enter"&&e.target.tagName==="INPUT"){
  e.preventDefault();
  var idx=requiredOrder.indexOf(e.target);
  if(idx>-1){
   var next=null;
   for(var i=idx+1;i<requiredOrder.length;i++){if(!requiredOrder[i].value){next=requiredOrder[i];break}}
   if(next){next.focus();return}
  }
  calculate();
 }
});
var progressDots=root.querySelectorAll(".mbc-progress-dot");
function updateProgress(){
 for(var i=0;i<requiredOrder.length;i++){
  progressDots[i].classList.toggle("mbc-filled",!!requiredOrder[i].value);
 }
}
requiredOrder.forEach(function(inp){inp.addEventListener("input",updateProgress)});

(function prefillFromUrl(){
 try{
  var qs=new URLSearchParams(location.search);
  if(!qs.has("chest"))return;
  if(qs.get("unit")==="in")setUnit("in",uBtns,function(v){unit=v;for(var i=0;i<units.length;i++)units[i].textContent=v});
  el.chest.value=qs.get("chest")||"";el.waist.value=qs.get("waist")||"";el.hips.value=qs.get("hips")||"";
  if(qs.get("age"))el.age.value=qs.get("age");
  if(qs.get("ht"))el.ht.value=qs.get("ht");
  if(qs.get("wt")){el.wt.value=qs.get("wt"); if(qs.get("wunit")==="lb")setUnit("lb",wBtns,function(v){wUnit=v;el.wu.textContent=v});}
  calculate();
 }catch(e){}
})();
})();
</script>
